# 이벤트 원장 — 실제 업무 데이터. 절대 커밋하지 않는다.
*.db
*.db-journal
*.db-wal
*.db-shm

# 볼트 실데이터. 구조(빈 디렉터리)만 저장소에 둔다.
vault/work/ideas/*
vault/work/notes/*
vault/personal/ideas/*
vault/personal/notes/*
!vault/**/.gitkeep

# GEPA 제안·리포트 (재생성 가능)
proposals/
*.gepa.json

# 캡처 원본
captures/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 로컬 프로파일 오버라이드 — 사내 호스트명이 들어갈 수 있다
profiles/*.local.json

# OS / 에디터
.DS_Store
Thumbs.db
.vscode/
.idea/
